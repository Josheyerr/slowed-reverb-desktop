{
  "name": "slowed-reverb-desktop",
  "version": "1.0.6",
  "description": "Local audio remixer — slowed + reverb, bass boost, EQ, pitch/tempo",
  "main": "./out/main/index.js",
  "author": "SlowedAndReverb",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never",
    "publish": "node scripts/publish-release.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke:dsp": "node scripts/dsp-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.15.0",
    "lamejs": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "soundtouchjs": "^0.2.1",
    "youtube-dl-exec": "^3.1.11",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
