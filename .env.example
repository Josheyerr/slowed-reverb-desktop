# Local secrets — never commit this file.

# Required gate for `npm run publish` (must be exactly 1). Without this, publish exits.
# Do not set this for normal builds — use `npm run dist` instead (never uploads).
# CONFIRM_PUBLISH=1

# Publishing releases (upload to GitHub). Optional if `gh auth login` is active —
# the publish script will use `gh auth token` when GH_TOKEN is unset.
# GH_TOKEN=ghp_...

# Optional: only needed if the update feed repo is private.
# Public releases do not require this.
# UPDATE_FEED_TOKEN=

UPDATE_OWNER=Josheyerr
UPDATE_REPO=slowed-reverb-desktop
